%% Knowledge Gym ERD — 32 PG tables + Redis (compact for IDE preview)
%% Full columns: docs/07-erd.md | MVP Must 16 + Optional 3 + Full 13 (see § MVP schema vs Full)
flowchart TB
    subgraph ID["Identity (6)"]
        direction LR
        users["users\nPK id · UK email · xp"]
        refresh_tokens["refresh_tokens"]
        password_reset_codes["password_reset_codes"]
        notification_preferences["notification_preferences\nUK user_id+channel"]
        audit_logs["audit_logs"]
        user_badges["user_badges\nPK user_id+badge_code"]
    end

    subgraph CT["Content (4)"]
        direction LR
        topics["topics"]
        modules["modules"]
        questions["questions"]
        question_options["question_options"]
    end

    subgraph LR2["Learning (13)"]
        direction TB
        srs_decks["srs_decks"]
        srs_cards["srs_cards\nUK user+question"]
        quiz_sessions["quiz_sessions"]
        quiz_answers["quiz_answers"]
        interview_sessions["interview_sessions"]
        interview_answers["interview_answers"]
        study_attempts["study_attempts"]
        user_progress["user_progress\nUK user+module"]
        notifications["notifications"]
        daily_challenge_assignments["daily_challenge_assignments\nUK user+date"]
        challenges["challenges"]
        challenge_test_cases["challenge_test_cases"]
        code_submissions["code_submissions\nFK challenge_id"]
    end

    subgraph NT["Notes (1)"]
        notes["notes\nQUICK/STUDY/HIGHLIGHT/BOOKMARK"]
    end

    subgraph BG["Blog Agent (8)"]
        direction TB
        collector_sources["collector_sources"]
        collected_items["collected_items"]
        blog_posts["blog_posts"]
        blog_comments["blog_comments"]
        blog_views["blog_views\nUK post+user"]
        blog_post_likes["blog_post_likes\nUK post+user"]
        blog_generation_queue["blog_generation_queue"]
        agent_runs["agent_runs"]
    end

    subgraph RD["Redis cache - not PG"]
        direction LR
        redis_keys["rt:* · pwd_reset · rl:*\ncache:* · lb:* · streak:*"]
    end

