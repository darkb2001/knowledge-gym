{
  "name": "kg-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:local": "next dev --hostname :: --port 3100",
    "start:local": "next start --hostname :: --port 3100",
    "preview:local": "npm run build && npm run start:local",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "isomorphic-dompurify": "^2.21.0",
    "marked": "^15.0.12",
    "next": "15.5.24",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^8",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "vite": "7.3.6"
  }
}
