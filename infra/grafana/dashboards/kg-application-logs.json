{
  "id": null,
  "uid": "kg-application-logs",
  "title": "Knowledge Gym — Application Overview & Logs",
  "tags": [
    "knowledge-gym",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(deployment_environment_name)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({deployment_environment_name=\"$environment\"}, service_name)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "knowledge-gym",
          "value": "knowledge-gym"
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": ".*,INFO,WARN,ERROR,DEBUG",
        "current": {
          "text": "All",
          "value": ".*"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ]
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP throughput / status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Application logs — expand a line → Open trace",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"${service:regex}\", deployment_environment_name=~\"${environment:regex}\"} | json | level=~\"${level:regex}\" | request_id=~\"${request_id:regex}.*\" | trace_id=~\"${trace_id:regex}.*\"",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
