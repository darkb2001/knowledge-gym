# Knowledge Gym — production environment (copy → .env, KHÔNG commit .env).
#
#   cp .env.example .env && chmod 600 .env
#
# Mọi biến có dấu ? trong docker-compose.prod.yml là bắt buộc: thiếu là
# `docker compose up` dừng ngay, không chạy với giá trị mặc định nguy hiểm.

# ---------------------------------------------------------------------------
# Bắt buộc — sinh bằng: openssl rand -base64 48
# JwtSecretValidator chặn nếu chuỗi < 32 ký tự (và chặn cả khi app chạy prod).
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL — KHÔNG dùng postgres/postgres như compose dev.
# Sinh: openssl rand -base64 32
# ---------------------------------------------------------------------------
POSTGRES_DB=knowledgegym
POSTGRES_USER=kg_app
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Garage (S3 self-host). Lấy giá trị thật bằng: bash scripts/setup-garage.sh
# hoặc sinh thủ công (access key = GK + 24 hex, secret = 48 hex).
# ---------------------------------------------------------------------------
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_ADMIN_TOKEN=
GARAGE_DEFAULT_BUCKET=kg-local

# ---------------------------------------------------------------------------
# Grafana admin — bắt buộc, không để mặc định admin/admin.
# ---------------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=
# Nếu expose Grafana qua tunnel: đặt đúng URL công khai để redirect/login đúng.
GRAFANA_ROOT_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Domain + CORS.
# FE ở app.darkb-tech.io.vn, API ở api.darkb-tech.io.vn → CÙNG registrable
# domain, nên refresh cookie là same-site (không phải third-party cookie).
# Nhiều origin thì phân tách bằng dấu phẩy.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.darkb-tech.io.vn
OAUTH2_SUCCESS_REDIRECT=https://app.darkb-tech.io.vn/auth/oauth2/success
OAUTH2_FAILURE_REDIRECT=https://app.darkb-tech.io.vn/auth/oauth2/error
BLOG_CANONICAL_BASE_URL=https://app.darkb-tech.io.vn

# ---------------------------------------------------------------------------
# Session hardening (docs/33-auth-session-hardening-plan.md).
# REFRESH_ABSOLUTE_TTL: hạn tuyệt đối kể từ lần login đầu của một phiên, chặn
# rolling TTL 7 ngày gia hạn vô thời hạn. Định dạng Spring Duration (`30d`,
# `720h`, `PT720H`). Đặt `0` để tắt (rolling thuần) — dùng khi cần rollback
# nhanh mà không build lại.
# ORIGIN_GUARD_ENABLED: chặn request mutating mang refresh cookie nếu Origin/
# Referer không nằm trong CORS_ALLOWED_ORIGINS. Chỉ tắt khi có sự cố.
# ---------------------------------------------------------------------------
REFRESH_ABSOLUTE_TTL=30d
ORIGIN_GUARD_ENABLED=true

# ---------------------------------------------------------------------------
# Docs content import.
# THƯ MỤC PHẢI TỒN TẠI trên CT trước khi compose up (đường dẫn tuyệt đối).
# Nội dung = docs/*.html (index.html + NN-slug.html) của repo javaNote, KHÔNG
# phải knowledge-gym/docs (markdown planning docs).
# ---------------------------------------------------------------------------
KG_DOCS_DIR=/opt/kg-docs

# ---------------------------------------------------------------------------
# Google OAuth2 (Google Cloud Console).
# Redirect URI phải khai đúng:
#   Prod: https://api.darkb-tech.io.vn/api/v1/login/oauth2/code/google
#   Dev:  http://localhost:8080/api/v1/login/oauth2/code/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Production release pin. CI supplies this as APP_IMAGE=...:sha-<short>.
# Do not use :latest for a manual production start.
APP_IMAGE=

# ---------------------------------------------------------------------------
# Internal cron. docker-compose.prod.yml KHÔNG có default cho CRON_TOKEN
# (`${CRON_TOKEN:?}`) — thiếu là `docker compose up` dừng ngay.
# Sinh: openssl rand -hex 32
#   APP_CRON_MODE=external  → TẮT collect/writer/backup trong app; scheduler
#                             ngoài (LXC cron / Lambda) gọi POST /internal/*.
#                             Outbox relay + stale-GENERATING reclaim vẫn chạy.
#   APP_CRON_MODE=embedded  → app tự chạy @Scheduled (dùng cho local/dev).
# KHÔNG bao giờ chạy cả hai cho cùng một job.
# ---------------------------------------------------------------------------
CRON_TOKEN=
APP_CRON_MODE=external

# Host ops on CT102 (LXC with Docker — NOT the PVE node). No docker.sock in app.
# Prefer HTTP agent on Docker bridge gateway (measured: 127.0.0.1 unreachable from app).
# Example: KG_ES_CONTROL_URL=http://172.18.0.1:9377
KG_ES_CONTROL_URL=
KG_ES_CONTROL_TOKEN=
KG_BACKUP_SCRIPT=/opt/kg/scripts/backup-db.sh
# Legacy ProcessBuilder fallback only if the JVM runs on the CT host (not in app container).
KG_ES_CONTROL_SCRIPT=
KG_SCRIPT_TIMEOUT_SECONDS=900
KG_ES_STOP_MARKER=/opt/kg/run/elasticsearch.stopped

# ---------------------------------------------------------------------------
# Search index (Elasticsearch 8). Mặc định TẮT: `GET /search` chạy câu
# PostgreSQL tsvector như trước. Bật thì index được giữ qua trigger
# `search_outbox` + relay nền; ES chết vẫn fallback về tsvector nên không sập
# search. Prod compose default = true.
# Index/chỉ mục phải khớp prefix mà scripts/es-retention.sh xoá theo ngày:
# mặc định `knowledge-gym-search` KHÔNG có hậu tố ngày, nên retention hiện chỉ
# tác động index dạng `knowledge-gym-YYYY.MM.DD` (xem docs/07-erd.md).
# ---------------------------------------------------------------------------
APP_SEARCH_ES_ENABLED=false
APP_SEARCH_ES_INDEX=knowledge-gym-search

# ---------------------------------------------------------------------------
# Object storage (Garage S3 API). STORAGE_S3_ENABLED=true trong compose prod.
# S3_ENDPOINT dùng cho app→Garage trong mạng Docker (`http://garage:3900`).
# S3_PUBLIC_ENDPOINT dùng để KÝ presigned URL → phải là hostname browser gọi
# được (Garage expose qua Cloudflare Tunnel). Đặt nhầm thành `garage:3900` thì
# GET/PUT presigned fail ở browser mà app không log gì.
# S3_REGION chỉ là giá trị SDK bắt buộc — Garage bỏ qua.
# ---------------------------------------------------------------------------
S3_PUBLIC_ENDPOINT=https://s3.darkb-tech.io.vn
S3_REGION=garage

# ---------------------------------------------------------------------------
# Email. Mặc định TẮT: để false thì KHÔNG gửi thư nào — mã quên mật khẩu chỉ nằm
# trong log container (nhánh DEV-FALLBACK). Bật = true + điền app password Gmail,
# rồi nghiệm thu theo docs/24-mail-prod.md. Rotate secret xong phải nghiệm thu lại.
# ---------------------------------------------------------------------------
MAIL_SMTP_ENABLED=false
# Queue verification/reset mail through PostgreSQL outbox + Kafka. Requires Kafka running.
MAIL_KAFKA_ENABLED=false
MAIL_HEALTH_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
APP_EMAIL_FROM=no-reply@knowledgegym.dev
APP_EMAIL_FROM_NAME=Knowledge Gym

# ---------------------------------------------------------------------------
# Blog AI writer — mặc định TẮT. Bật chỉ khi có budget được kiểm soát.
# ---------------------------------------------------------------------------
APP_BLOG_WRITER_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 9router model hiện dùng trên production.
OPENAI_MODEL=vibe-daily
APP_BLOG_WRITER_DAILY_REQUEST_LIMIT=20
APP_BLOG_WRITER_DAILY_TOKEN_LIMIT=80000
APP_BLOG_WRITER_DAILY_COST_LIMIT_USD=1
APP_BLOG_WRITER_MONTHLY_COST_ALERT_USD=5

# Collector gọi ra ngoài internet theo lịch — bật sau khi đã import content.
APP_BLOG_COLLECTOR_ENABLED=false
APP_BLOG_KAFKA_ENABLED=true
# Kafka topics: email.verification, email.password-reset; failed delivery goes to email.events.dlq

# ---------------------------------------------------------------------------
# Backup offsite (restic → Backblaze B2). Dùng bởi scripts/backup-db.sh.
# B2_APPLICATION_KEY và RESTIC_PASSWORD_FILE trỏ tới file ngoài compose env,
# không commit. Xem docs/19-m11b-ops.md + docs/20-backup-restore-drill.md.
# ---------------------------------------------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
RESTIC_PASSWORD_FILE=/etc/kg-backup/restic.pw
RESTIC_BUCKET=b2:kg-db-backups
GARAGE_BACKUP=1
CONFIG_BACKUP=1
# ES retention / disk guard (scripts/es-retention.sh on host cron)
# ES is internal-only; run retention from the Docker network or resolve the
# container IP at runtime. The host must not assume 127.0.0.1:9200 is open.
ES_URL=http://elasticsearch:9200
ES_LIVE_INDEX=knowledge-gym-search
ES_MAX_SIZE_GB=20
ES_RETENTION_DAYS=30
